{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "title": "homeassistant-kubernetes-rbac values",
  "type": "object",
  "required": ["mode", "rbac"],
  "if": {
    "properties": { "mode": { "const": "minimal" } },
    "required": ["mode"]
  },
  "then": {
    "properties": {
      "rbac": {
        "properties": {
          "writeNamespaces": { "enum": [["*"], []] }
        }
      }
    }
  },
  "properties": {
    "mode": {
      "description": "Permission set: full (all features) or minimal (read-only).",
      "type": "string",
      "enum": ["full", "minimal"]
    },
    "nameOverride": {
      "description": "Name of the ServiceAccount, ClusterRole and ClusterRoleBinding. The <name>-write ClusterRole and its RoleBindings (rbac.writeNamespaces) follow it.",
      "type": "string"
    },
    "serviceAccount": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" },
        "annotations": { "type": "object" }
      }
    },
    "tokenSecret": {
      "type": "object",
      "properties": {
        "create": { "type": "boolean" }
      }
    },
    "rbac": {
      "type": "object",
      "required": ["writeNamespaces"],
      "additionalProperties": false,
      "properties": {
        "create": { "type": "boolean" },
        "writeNamespaces": {
          "description": "Namespaces in which mode=full may change resources: [\"*\"] for all, a list of names, or [] for none. \"*\" must stand alone.",
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^(\\*|[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)$"
          },
          "if": { "contains": { "const": "*" } },
          "then": { "maxItems": 1 }
        },
        "extraRules": {
          "description": "Extra policy rules appended to the ClusterRole.",
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "apiGroups": { "type": "array", "items": { "type": "string" } },
              "resources": { "type": "array", "items": { "type": "string" } },
              "resourceNames": { "type": "array", "items": { "type": "string" } },
              "verbs": { "type": "array", "items": { "type": "string" } },
              "nonResourceURLs": { "type": "array", "items": { "type": "string" } }
            },
            "required": ["verbs"]
          }
        }
      }
    }
  }
}
