{
  "name": "homeassistant-kubernetes-panel",
  "version": "1.12.1",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "dev": "vite build --watch --outDir ../.vite-dev",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write 'src/**/*.ts'",
    "format:check": "prettier --check 'src/**/*.ts'"
  },
  "dependencies": {
    "lit": "^3.3.3"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.70.1",
    "eslint": "^10.11.0",
    "eslint-plugin-lit": "^2.3.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "vite": "^8.3.1"
  }
}
