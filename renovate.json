{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>tibuntu/renovate-presets",
    "github>tibuntu/renovate-presets:automerge",
    "github>tibuntu/renovate-presets:semanticCommitType(*, build)",
    "github>tibuntu/renovate-presets:githubActionsCommitType"
  ],
  "pre-commit": {
    "enabled": true
  },
  "lockFileMaintenance": {
    "enabled": false
  },
  "packageRules": [
    {
      "matchManagers": ["npm"],
      "lockFileMaintenance": {
        "enabled": true,
        "schedule": ["on sunday"]
      }
    },
    {
      "matchFileNames": ["pyproject.toml"],
      "semanticCommitScope": "deps",
      "groupName": "dev dependencies"
    },
    {
      "matchUpdateTypes": ["patch"],
      "groupName": "patch updates",
      "schedule": ["on sunday"]
    },
    {
      "matchPackageNames": ["kubernetes"],
      "groupName": "kubernetes",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks",
      "semanticCommitScope": "deps"
    },
    {
      "matchManagers": ["github-actions"],
      "groupName": "github-actions",
      "semanticCommitScope": "deps-actions"
    },
    {
      "matchManagers": ["devcontainer"],
      "groupName": "devcontainer",
      "semanticCommitScope": "deps-devcontainer"
    },
    {
      "matchDepNames": ["ruff", "astral-sh/ruff-pre-commit"],
      "groupName": "ruff",
      "semanticCommitScope": "deps"
    },
    {
      "matchDepNames": ["mypy", "pre-commit/mirrors-mypy"],
      "groupName": "mypy",
      "semanticCommitScope": "deps"
    },
    {
      "matchDepNames": ["bandit", "pycqa/bandit"],
      "groupName": "bandit",
      "semanticCommitScope": "deps"
    },
    {
      "matchDepNames": ["typescript", "@typescript-eslint/eslint-plugin", "@typescript-eslint/parser"],
      "groupName": "typescript",
      "semanticCommitScope": "deps-frontend"
    },
    {
      "description": "Pin TypeScript <7 until typescript-eslint supports it (peer: >=4.8.4 <6.1.0). Remove this rule once @typescript-eslint/eslint-plugin allows TS 7.",
      "matchDepNames": ["typescript"],
      "allowedVersions": "<7"
    },
    {
      "matchFileNames": ["frontend/package.json"],
      "matchDepTypes": ["dependencies"],
      "groupName": "frontend runtime dependencies",
      "semanticCommitType": "fix",
      "semanticCommitScope": "deps-frontend",
      "rangeStrategy": "bump",
      "postUpgradeTasks": {
        "commands": [
          "npm install --prefix frontend",
          "npm run build --prefix frontend"
        ],
        "fileFilters": [
          "frontend/package-lock.json",
          "custom_components/kubernetes/frontend/kubernetes-panel.js"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchFileNames": ["frontend/package.json"],
      "matchDepTypes": ["devDependencies"],
      "groupName": "frontend dev dependencies",
      "semanticCommitScope": "deps-frontend",
      "rangeStrategy": "bump",
      "postUpgradeTasks": {
        "commands": [
          "npm install --prefix frontend",
          "npm run build --prefix frontend"
        ],
        "fileFilters": [
          "frontend/package-lock.json",
          "custom_components/kubernetes/frontend/kubernetes-panel.js"
        ],
        "executionMode": "branch"
      }
    },
    {
      "matchDepNames": ["pytest-homeassistant-custom-component", "homeassistant", "pytest", "pytest-asyncio"],
      "groupName": "homeassistant",
      "semanticCommitScope": "deps"
    },
    {
      "description": "Helm CLI pin (azure/setup-helm, extracted by the github-actions manager) shared by the chart, release and compat workflows",
      "matchDepNames": ["helm"],
      "groupName": "helm",
      "semanticCommitScope": "deps-actions"
    },
    {
      "description": "Kubernetes stable version pin for the compat CI matrix — also updates the supported-version range in docs",
      "matchDepNames": ["kubernetes/kubernetes"],
      "groupName": "kubernetes-latest",
      "semanticCommitScope": "deps-actions",
      "postUpgradeTasks": {
        "commands": [
          "scripts/update-k8s-support-range.sh {{{newVersion}}}"
        ],
        "fileFilters": [
          "README.md",
          "docs/SETUP.md"
        ],
        "executionMode": "branch"
      }
    },
    {
      "description": "One Python version across CI, pre-commit and the HA requirements check",
      "matchDepNames": ["python"],
      "groupName": "python",
      "semanticCommitScope": "deps"
    },
    {
      "description": "kind CLI pin for the compat CI matrix — the node images are resolved from the same kind release",
      "matchDepNames": ["kubernetes-sigs/kind"],
      "semanticCommitScope": "deps-actions"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Track the Python version in CI workflows, pre-commit and the HA requirements check",
      "managerFilePatterns": [
        "/\\.github/workflows/.*\\.ya?ml$/",
        "/^\\.pre-commit-config\\.yaml$/",
        "/^scripts/check-ha-requirements\\.sh$/"
      ],
      "matchStrings": [
        "PYTHON_VERSION:\\s*[\"'](?<currentValue>[0-9.]+)[\"']",
        "\\n  python: python(?<currentValue>3\\.[0-9]+)\\n",
        "--python-version (?<currentValue>3\\.[0-9]+)"
      ],
      "depNameTemplate": "python",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "Track the latest stable Kubernetes version for the compat CI matrix",
      "managerFilePatterns": [
        "/\\.github/workflows/k8s-compat\\.ya?ml$/"
      ],
      "matchStrings": [
        "K8S_LATEST:\\s*\"(?<currentValue>[0-9.]+)\""
      ],
      "depNameTemplate": "kubernetes/kubernetes",
      "datasourceTemplate": "github-releases",
      "extractVersionTemplate": "^v(?<version>.*)$"
    },
    {
      "customType": "regex",
      "description": "Track the kind CLI version for the compat CI matrix",
      "managerFilePatterns": [
        "/\\.github/workflows/k8s-compat\\.ya?ml$/"
      ],
      "matchStrings": [
        "KIND_VERSION:\\s*\"(?<currentValue>v[0-9.]+)\""
      ],
      "depNameTemplate": "kubernetes-sigs/kind",
      "datasourceTemplate": "github-releases"
    }
  ]
}
